{
  "$comment": "Client de l'écran de notation humaine : compilé en modules ES par tsc seul, sans empaqueteur, comme validation/client. Autonome : il n'importe rien du dépôt, ses types sont ceux des réponses de l'API (types.ts). \"types\": [] le prive des types Node.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
