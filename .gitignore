node_modules/
validation/client/dist/

# Brouillons de saisie : ni décisions, ni données publiables. Écrasables par nature,
# donc hors du journal append-only et hors du dépôt.
validation/brouillons/

# Journal corrompu mis en quarantaine par la détection d'écriture interrompue.
*.incomplet

# Décisions et brouillons du jeu de démonstration : des essais, pas des validations.
validation/fixtures/decisions-demo/
validation/fixtures/brouillons-demo/

# Worktrees des sous-agents (Claude Code) : des copies de travail, jamais du contenu du dépôt.
.claude/worktrees/

# Copies locales des sources collectées (pipeline/collecte) : hors Git par décision du 2026-09-22.
# Git ne garde que les manifestes staging/sources/<sha256>.json (docs/CONTRATS.md §5).
archives/

# Poids du modèle de transcription (pipeline/collecte/transcription/poids.py) : 1,6 Go téléchargés
# au premier lancement à une révision épinglée, empreintes vérifiées avant chargement. Jamais dans Git.
modeles/

# Environnement Python géré par uv, et caches.
.venv/
__pycache__/
.pytest_cache/

# Textes canoniques et transcriptions intégrales des sources : hors Git par décision du 2026-09-25
# (constat de conformité n° 31). Le §10 ne publie une copie intégrale que si sa licence le permet,
# et d'un enregistrement T2 que la transcription de l'extrait. On publie l'empreinte, l'archive de
# référence et la citation ; un tiers réextrait le texte de l'archive avec le code publié. Les
# fiches .json de ces répertoires (traçabilité de la production, §9) restent versionnées.
/staging/textes/*.txt
/staging/transcriptions/*.vtt
